# Copy to .env and fill in real values.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ramasala

# Admin login credentials. These are SHA-256 hex hashes of the plaintext
# email/password. Generate them with:
#   node scripts/generate-admin-hashes.js "admin@yourdomain.com" "YourPassword"
ADMIN_EMAIL_HASH=change_me
ADMIN_PASSWORD_HASH=change_me
ADMIN_NAME=Kai Super Admin

# PRODUCTION PAYMENT GATEWAY API KEYS
# NOTE: keys containing "mock" or "xxxx" are treated as NOT live, so online
# payments are disabled until real keys are set here OR in the admin panel
# (Payment Settings, stored in the payment_settings DB record, which overrides .env).
GATEWAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
GATEWAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# PASSWORD RESET EMAIL (SMTP)
# Public URL of the deployed FRONTEND (Vercel), used to build the reset link.
# Local:  http://localhost:5173
# Prod:   https://your-app.vercel.app  (must match your live site exactly)
APP_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail: use the sender Gmail + a Google App Password (not your normal password).
# https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
# For Gmail, From MUST be the same address as SMTP_USER or mail is rejected.
SMTP_FROM=RA Masala <your-gmail-address@gmail.com>
# Set to false only if your network intercepts TLS certificates (office/college firewall).
# On public hosting like Render/Railway keep the default (true).
SMTP_REJECT_UNAUTHORIZED=true
# Optional SMTP timeouts (ms) — prevents the API from hanging in production.
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000